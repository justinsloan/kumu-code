PRINT "=== Variables and Arithmetic ==="
VAR a = 10
VAR b = 3
PRINT a + b
PRINT a - b
PRINT a * b
PRINT a / b

PRINT "=== Bare Assignment (no VAR) ==="
a = 99
PRINT a

PRINT "=== String Concatenation ==="
VAR name = "World"
PRINT "Hello, " + name
PRINT "Value of a is: " + a

PRINT "=== Comparison Operators (1 = true, 0 = false) ==="
PRINT 5 == 5
PRINT 5 != 5
PRINT 5 < 10
PRINT 5 > 10
PRINT 5 <= 5
PRINT 5 >= 6
PRINT "abc" == "abc"
PRINT "abc" != "xyz"

PRINT "=== Unary Operators ==="
VAR neg = -a
PRINT neg
PRINT -(-5)
PRINT !0
PRINT !1

PRINT "=== IF / ELSE ==="
VAR score = 85
IF score >= 60 {
    PRINT "Pass"
} ELSE {
    PRINT "Fail"
}

PRINT "=== IF / ELSE (a second condition) ==="
IF score >= 90 {
    PRINT "A grade"
} ELSE {
    PRINT "Not an A"
}

PRINT "=== IF / ELSEIF / ELSE (multi-way) ==="
IF score >= 90 {
    PRINT "A"
} ELSEIF score >= 80 {
    PRINT "B"
} ELSEIF score >= 70 {
    PRINT "C"
} ELSE {
    PRINT "F"
}

PRINT "=== WHILE loop ==="
VAR i = 0
WHILE i < 5 {
    PRINT i
    i = i + 1
}

PRINT "=== FOR loop ==="
FOR j = 1 TO 5 {
    PRINT j
}

PRINT "=== FUNCTION, RETURN, and calls (including recursion) ==="
FUNCTION add(x, y) {
    RETURN x + y
}

FUNCTION factorial(n) {
    IF n <= 1 {
        RETURN 1
    } ELSE {
        RETURN n * factorial(n - 1)
    }
}

PRINT add(4, 7)
PRINT factorial(5)

PRINT "=== File I/O: WRITE_FILE / READ_FILE ==="
WRITE_FILE("test_output.txt", "Hello from Kumu!")
VAR fileContent = READ_FILE("test_output.txt")
PRINT fileContent

PRINT "=== Matrix: literals, GET/SET, ROWS/COLS ==="
VAR data = (
    ("Name", "Score"),
    ("Alice", "95"),
    ("Bob", "88"),
    ("Carol", "72")
)
PRINT data
PRINT data.ROWS()
PRINT data.COLS()
PRINT data.GET(1, "Name")
PRINT data.GET(2, 2)
VAR updated = data.SET(1, "Score", "100")
PRINT updated.GET(1, "Score")
PRINT data.GET(1, "Score")

PRINT "=== Matrix: APPEND_ROW / DELETE_ROW ==="
VAR withDavid = data.APPEND_ROW("David", "60")
PRINT withDavid.ROWS()
VAR withoutAlice = withDavid.DELETE_ROW(1)
PRINT withoutAlice

PRINT "=== Matrix: SUM / AVERAGE / MIN / MAX / COUNT ==="
PRINT data.SUM("Score")
PRINT data.AVERAGE("Score")
PRINT data.MIN("Score")
PRINT data.MAX("Score")
PRINT data.COUNT("Score")

VAR messyPrices = (
    ("Item", "Price"),
    ("Widget", "9.99"),
    ("Gadget", "N/A"),
    ("Gizmo", ""),
    ("Thing", "15.50")
)
PRINT messyPrices.COUNT("Price")   # only the two real numbers count, N/A and blank are skipped

PRINT "=== Matrix: FIND / SORT ==="
PRINT data.FIND("Name", "Bob")
PRINT data.FIND("Name", "Nobody")
PRINT data.SORT("Score")
PRINT data.SORT("Name")

PRINT "=== Matrix: SAVE / READ_CSV round-trip ==="
data.SAVE("test_scores.csv")
VAR loaded = READ_CSV("test_scores.csv")
PRINT loaded

PRINT "=== RANDOM ==="
PRINT RANDOM(1, 6)      # a random number from 1 to 6
PRINT RANDOM(1, 100)    # a random number from 1 to 100
PRINT RANDOM(5, 5)      # degenerate range: always 5

PRINT "=== TRY / CATCH ==="
TRY {
    PRINT 10 / 0
} CATCH err {
    PRINT "Caught: " + err
}
PRINT "Still running after TRY/CATCH"

TRY {
    PRINT RANDOM(10, 1)
} CATCH err {
    PRINT "Caught: " + err
}

PRINT "=== INPUT ==="
PRINT "(wrapped in TRY/CATCH so this still runs cleanly with nothing piped in)"
TRY {
    PRINT "Type something and press Enter:"
    INPUT userValue
    PRINT "You entered: " + userValue
} CATCH err {
    PRINT "No input available (expected if nothing was piped in): " + err
}

PRINT "=== CLEAR_SCREEN and SLEEP ==="
PRINT "Pausing briefly, then clearing the screen (scrollback still keeps everything above)..."
SLEEP(0.2)
CLEAR_SCREEN()
PRINT "Screen cleared. CLEAR_SCREEN() and SLEEP() both work."

PRINT "=== Dates ==="
# TODAY() and NOW() are deliberately not printed: their output changes
# from day to day, which would make this file impossible to diff against
# a saved expectation. Everything below is a fixed date with a known
# answer.
PRINT "Weekday of 2026-09-23:      " + WEEKDAY("2026-09-23")
PRINT "Seven days on:              " + DATE_ADD("2026-09-23", 7)
PRINT "One day before 2026-01-01:  " + DATE_ADD("2026-01-01", -1)
PRINT "Days from 23rd to 30th:     " + DATE_DIFF("2026-09-23", "2026-09-30")
PRINT "...and backwards:           " + DATE_DIFF("2026-09-30", "2026-09-23")
PRINT "Parts of 2026-09-23:        " + YEAR("2026-09-23") + " / " + MONTH("2026-09-23") + " / " + DAY("2026-09-23")

PRINT "--- leap years ---"
PRINT "2024-02-28 plus a day:      " + DATE_ADD("2024-02-28", 1)
PRINT "2026-02-28 plus a day:      " + DATE_ADD("2026-02-28", 1)
PRINT "Feb to Mar 2024 (leap):     " + DATE_DIFF("2024-02-28", "2024-03-01")
PRINT "Feb to Mar 2026 (not):      " + DATE_DIFF("2026-02-28", "2026-03-01")
PRINT "A century of days:          " + DATE_DIFF("1900-01-01", "2000-01-01")

PRINT "--- month and year ends ---"
PRINT "2026-12-31 plus a day:      " + DATE_ADD("2026-12-31", 1)
PRINT "There and back again:       " + DATE_ADD(DATE_ADD("2026-09-23", 500), -500)

PRINT "--- IS_DATE is strict ---"
PRINT "2026-02-28 (real):          " + IS_DATE("2026-02-28")
PRINT "2024-02-29 (leap year):     " + IS_DATE("2024-02-29")
PRINT "2026-02-29 (not leap):      " + IS_DATE("2026-02-29")
PRINT "2026-02-30 (no such day):   " + IS_DATE("2026-02-30")
PRINT "2026-13-01 (no such month): " + IS_DATE("2026-13-01")
PRINT "2026-1-1 (needs padding):   " + IS_DATE("2026-1-1")
PRINT "26-01-01 (needs 4 digits):  " + IS_DATE("26-01-01")
PRINT "not a date at all:          " + IS_DATE("tomorrow")

PRINT "--- a bad date is an error, not a wrong answer ---"
TRY {
    PRINT DATE_ADD("2026-02-30", 1)
} CATCH err {
    PRINT "Caught: " + err
}

PRINT "--- ISO dates sort chronologically as plain text ---"
VAR dates = ["2026-12-31", "2026-01-05", "2026-09-23"]
PRINT "Ascending:  " + dates.SORT().JOIN(", ")
PRINT "Descending: " + dates.SORT(1).JOIN(", ")

PRINT "=== Sorting, ascending and descending ==="
VAR nums = [5, 2, 9, 1]
PRINT "Numbers up:   " + nums.SORT().JOIN(", ")
PRINT "Numbers down: " + nums.SORT(1).JOIN(", ")
VAR words = ["pear", "apple", "fig"]
PRINT "Words up:     " + words.SORT().JOIN(", ")
PRINT "Words down:   " + words.SORT(1).JOIN(", ")

VAR tasks = (
    ("Task", "Due"),
    ("write", "2026-10-01"),
    ("call", "2026-09-25"),
    ("ship", "2026-12-31")
)
PRINT "By due date, earliest first:"
PRINT tasks.SORT("Due")
PRINT "By due date, latest first:"
PRINT tasks.SORT("Due", 1)

PRINT "=== All tests completed ==="
